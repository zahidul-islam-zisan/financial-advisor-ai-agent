# Pulse Expense AI Agent Environment Configuration
# Copy this file to .env.local for local testing (NEVER commit .env or .env.local to Git)

# 1. Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Optional: Gemini Model ID (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. Base64-encoded Firebase Admin Service Account Key JSON
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Base64 string generated via:
#   Windows PowerShell: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("service-account.json"))
#   macOS/Linux:        base64 -w 0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON_HERE
