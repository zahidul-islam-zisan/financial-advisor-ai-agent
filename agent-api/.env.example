# Pulse Expense AI Agent Environment Configuration
# Copy this file to .env.local for local testing (NEVER commit .env or .env.local to Git)

# 1. Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Firebase Project ID (e.g. pulse-expense-3156f)
FIREBASE_PROJECT_ID=pulse-expense-3156f

# 3. Optional: Gemini Model ID (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
